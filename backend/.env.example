# Copy this file to ".env" and fill in your own values. NEVER commit ".env".
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Put the database name before the "?".
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/medicareplus?retryWrites=true&w=majority

# Long random text. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
SESSION_DAYS=7

# Where the React app runs (comma-separate several origins if needed)
CLIENT_ORIGIN=http://localhost:5173

# Cookie settings. Same-site setup (dev, or one domain): lax.
# Frontend and backend on different domains in production: COOKIE_SAMESITE=none (cookies are then Secure automatically).
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true

# Private upload folder (kept outside any public folder, ignored by Git)
UPLOAD_DIR=storage/uploads
MAX_FILE_SIZE_MB=5

# A dose still "due" this many minutes after its time becomes "overdue"
DOSE_GRACE_MINUTES=60
